+        private static string NavMeshJson(NavMeshFile navMesh)
+        {
+            using var stream = new MemoryStream();
+            using (var w = new System.Text.Json.Utf8JsonWriter(stream))
+            {
+                w.WriteStartObject();
+                w.WriteNumber("version", navMesh.Version);
+                w.WriteStartArray("areas");
+                foreach (var area in navMesh.Areas.Values)
+                {
+                    w.WriteStartObject();
+                    w.WriteNumber("id", area.AreaId);
+                    w.WriteNumber("hull", area.HullIndex);
+                    w.WriteNumber("flags", (long)area.AttributeFlags);
+                    w.WriteStartArray("corners");
+                    foreach (var c in area.Corners)
+                    {
+                        w.WriteStartArray();
+                        w.WriteNumberValue(c.X);
+                        w.WriteNumberValue(c.Y);
+                        w.WriteNumberValue(c.Z);
+                        w.WriteEndArray();
+                    }
+                    w.WriteEndArray();
+                    w.WriteStartArray("connections");
+                    foreach (var edge in area.Connections)
+                    {
+                        w.WriteStartArray();
+                        foreach (var connection in edge)
+                        {
+                            w.WriteNumberValue(connection.AreaId);
+                        }
+                        w.WriteEndArray();
+                    }
+                    w.WriteEndArray();
+                    w.WriteStartArray("hiding");
+                    foreach (var spot in area.HidingSpots)
+                    {
+                        w.WriteStartArray();
+                        w.WriteNumberValue(spot.Position.X);
+                        w.WriteNumberValue(spot.Position.Y);
+                        w.WriteNumberValue(spot.Position.Z);
+                        w.WriteNumberValue((int)spot.Flags);
+                        w.WriteEndArray();
+                    }
+                    w.WriteEndArray();
+                    w.WriteEndObject();
+                }
+                w.WriteEndArray();
+                w.WriteStartArray("ladders");
+                foreach (var ladder in navMesh.Ladders)
+                {
+                    w.WriteStartObject();
+                    w.WriteNumber("id", ladder.Id);
+                    w.WriteNumber("width", ladder.Width);
+                    w.WriteNumber("length", ladder.Length);
+                    w.WriteNumber("dir", (int)ladder.Direction);
+                    w.WriteStartArray("top");
+                    w.WriteNumberValue(ladder.Top.X);
+                    w.WriteNumberValue(ladder.Top.Y);
+                    w.WriteNumberValue(ladder.Top.Z);
+                    w.WriteEndArray();
+                    w.WriteStartArray("bottom");
+                    w.WriteNumberValue(ladder.Bottom.X);
+                    w.WriteNumberValue(ladder.Bottom.Y);
+                    w.WriteNumberValue(ladder.Bottom.Z);
+                    w.WriteEndArray();
+                    w.WriteStartArray("topAreas");
+                    foreach (var area in new[] { ladder.TopForwardArea, ladder.TopLeftArea, ladder.TopRightArea, ladder.TopBehindArea })
+                    {
+                        if (area != null)
+                        {
+                            w.WriteNumberValue(area.AreaId);
+                        }
+                    }
+                    w.WriteEndArray();
+                    w.WriteStartArray("bottomAreas");
+                    foreach (var area in new[] { ladder.BottomArea, ladder.BottomLeftArea, ladder.BottomRightArea })
+                    {
+                        if (area != null)
+                        {
+                            w.WriteNumberValue(area.AreaId);
+                        }
+                    }
+                    w.WriteEndArray();
+                    w.WriteEndObject();
+                }
+                w.WriteEndArray();
+                w.WriteEndObject();
+            }
+
+            return Encoding.UTF8.GetString(stream.ToArray());
+        }
