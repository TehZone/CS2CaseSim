+    // WebGL has no separate textures/samplers: merge them and name each pair "<texture>__<sampler>".
+    private static unsafe void CombineImageSamplers(spvc_compiler compiler)
+    {
+        uint dummySampler;
+        SpirvCrossApi.spvc_compiler_build_dummy_sampler_for_combined_images(compiler, &dummySampler);
+        SpirvCrossApi.spvc_compiler_build_combined_image_samplers(compiler);
+        spvc_combined_image_sampler* samplers;
+        nuint count;
+        SpirvCrossApi.spvc_compiler_get_combined_image_samplers(compiler, &samplers, &count);
+        for (nuint i = 0; i < count; i++)
+        {
+            var c = samplers[i];
+            var name = SpirvCrossApi.spvc_compiler_get_name(compiler, c.image_id) + "__" + SpirvCrossApi.spvc_compiler_get_name(compiler, c.sampler_id);
+            SpirvCrossApi.spvc_compiler_set_name(compiler, c.combined_id, name);
+        }
+    }
