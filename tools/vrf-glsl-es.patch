+    // GLSL ES 3.00 only has plain derivatives: turn OpDPdx/OpDPdy/OpFwidth Fine and Coarse into the plain ones and
+    // drop the DerivativeControl capability (declared as Shader instead), so SPIRV-Cross can emit GLSL ES.
+    private static byte[] PlainDerivatives(byte[] bytecode)
+    {
+        var words = new uint[bytecode.Length / 4];
+        Buffer.BlockCopy(bytecode, 0, words, 0, words.Length * 4);
+        for (var i = 5; i < words.Length;)
+        {
+            var count = (int)(words[i] >> 16);
+            var op = words[i] & 0xffff;
+            if (count == 0)
+            {
+                break;
+            }
+
+            if (op >= 210 && op <= 215)
+            {
+                words[i] = (words[i] & 0xffff0000u) | (207 + (op - 210) % 3);
+            }
+            else if (op == 17 && count == 2 && words[i + 1] == 51)
+            {
+                words[i + 1] = 1;
+            }
+
+            i += count;
+        }
+
+        var result = new byte[bytecode.Length];
+        Buffer.BlockCopy(words, 0, result, 0, words.Length * 4);
+        return result;
+    }
