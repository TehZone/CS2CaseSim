# Caddyfile template for the CS2 Case Simulator server (deploy/vps). setup.sh writes it to /etc/caddy/Caddyfile with
# your domain on the site line below and reloads Caddy:  sudo bash ~/vps/setup.sh server.example.com
# Caddy gets and renews the HTTPS certificate by itself, and WebSockets (the game's /ws) pass straight through.
# It puts the player's address in X-Forwarded-For and drops whatever the player sent in that header (no trusted_proxies
# here), so the server takes the one entry there: TRUST_PROXY=1 in /etc/cs2-server/env.
# A reload of Caddy closes open WebSockets (the game reconnects by itself): setup.sh reloads only when this changed.
__DOMAIN__ {
	reverse_proxy 127.0.0.1:8787
}
#website{
# The game's website (website/ in the repo), here only when setup.sh is given its domain (setup.sh --website <domain>).
# cs2-website.timer keeps __WEBROOT__ up to date with main and Caddy serves it as it is, with HTTPS for
# both names; the www. one redirects to the other. The server above isn't changed by any of this.
(cs2_website_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# The page's own files, plus the latest release's version and notes from GitHub's API (website/js/site.js).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}
}

__SITE__ {
	root * __WEBROOT__
	encode zstd gzip
	import cs2_website_headers

	# Players online, for the page: the server's /health at this site's own address (the page shows only `online`).
	@status {
		path /status
		method GET HEAD
	}
	handle @status {
		rewrite * /health
		reverse_proxy 127.0.0.1:8787 {
			header_down Cache-Control "no-store"
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Methods
		}
	}
	handle {
		file_server
	}

	# Caching: pages are checked every time (no-cache: unchanged, the ETag gets a 304), styles and scripts are kept for
	# 10 minutes, images for an hour (a changed one shows within the hour, even under the same name), fonts for a week.
	@pages path / *.html
	header @pages Cache-Control "no-cache"
	@code path *.css *.js *.webmanifest
	header @code Cache-Control "public, max-age=600"
	@media path *.webp *.jpg *.png *.ico *.svg
	header @media Cache-Control "public, max-age=3600"
	@fonts path *.woff2
	header @fonts Cache-Control "public, max-age=604800"
	# Types that Go's own table lacks (Caddy would otherwise go by /etc/mime.types, or send none).
	header @fonts Content-Type "font/woff2"
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"
	@icon path *.ico
	header @icon Content-Type "image/x-icon"

	handle_errors {
		import cs2_website_headers
		@notfound expression `{err.status_code} == 404`
		handle @notfound {
			rewrite * /404.html
			# (over whatever the address asked for set above: a missing .woff2 still gets the page as a page)
			header Cache-Control "no-cache"
			header Content-Type "text/html; charset=utf-8"
			file_server
		}
	}
}

www.__SITE__ {
	redir https://__SITE__{uri} permanent
}
#website}
