# cs2-website.service: one run of the website's sync (deploy/vps/website-sync.sh): when main moved, check out its
# website/ in /opt/cs2-website, which Caddy serves. cs2-website.timer starts it about every minute; setup.sh installs both
# when it's given the website's domain. It never touches the game server (cs2-server, its clone or its deploys).
#   sudo systemctl start cs2-website     (a run now)     journalctl -u cs2-website     (what the runs did)
[Unit]
Description=CS2 Case Simulator website: check out website/ from main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cs2web
Group=cs2web
Environment=HOME=/var/lib/cs2-website
ExecStart=/usr/local/lib/cs2-server/website-sync.sh
SyslogIdentifier=cs2-website
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
UMask=0022

# Hardening: it reads GitHub and writes its clone and its home, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/cs2-website /var/lib/cs2-website
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
